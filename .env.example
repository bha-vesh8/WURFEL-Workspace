# GEMINI_API_KEY: Required for live Gemini AI analysis.
# When omitted, WURFEL runs local deterministic extraction and rule checks, plus clearly labelled Demo Analysis mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Vision-capable model used for technical dossier and drawing analysis
GEMINI_MODEL="gemini-3.8-flash"

# PORT: Local Express + Vite server port
PORT="3000"

# MAX_UPLOAD_SIZE_MB: Maximum size per uploaded file in MB
MAX_UPLOAD_SIZE_MB="25"

# DATA_DIR: Local directory for SQLite database and project file uploads
DATA_DIR="./data"

# APP_URL: Local or hosted application URL
APP_URL="http://localhost:3000"
